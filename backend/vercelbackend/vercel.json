{
    "version": 2,
    "builds": [
      {
        "src": "backend/vercelbackend/server.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "backend/vercelbackend/server.js"
      }
    ],
    "env": {
      "MONGODB_URI": "@mongodb-uri"
    }
  }